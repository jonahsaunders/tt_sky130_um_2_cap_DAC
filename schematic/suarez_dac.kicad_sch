      (instances (project "suarez_dac" (path "/23a78c00-6192-4e34-9b74-1f5985e13cd5" (reference "#PWR014") (unit 1))))) (text "OPERATING SEQUENCE" (at 15 259 0) (effects (font (size 1.5 1.5) (bold yes)) (justify left)) (uuid "1c43615f-b6d9-4767-bbae-7f683bc6b05c")) (text "Initialize: HIGH=0, LOW=1, SHARE=1 for 8 us. Then all phases off for 0.2 us." (at 15 265 0) (effects (font (size 1.12 1.12)) (justify left)) (uuid "ae8d10fa-d6a1-489a-9422-d1bc25b988f9")) (text "8 bits, LSB first: charge 2 us; dead 0.2 us; share 2 us; dead 0.2 us. Read 3 us after bit 7." (at 15 271 0) (effects (font (size 1.12 1.12)) (justify left)) (uuid "327fd6a4-d18e-4271-9d11-b9a9483dc637")) (text "HIGH / LOW never overlap. LOW / SHARE overlap only during initialization. External controller supplies dead time." (at 15 277 0) (effects (font (size 1.02 1.02)) (justify left)) (uuid "bf817a04-a6f5-4962-874e-ebd94dbb50b4")) (text "Bodies: all NMOS -> VGND; all PMOS -> VDPWR. Body ties are explicit in SPICE / silicon." (at 15 283 0) (effects (font (size 1.02 1.02)) (justify left)) (uuid "083210dc-04b2-4588-860e-62162b0d15aa")) (sheet_instances (path "/" (page "1"))))
