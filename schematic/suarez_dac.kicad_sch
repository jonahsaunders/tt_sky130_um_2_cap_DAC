      (instances (project "suarez_dac" (path "/d2f4e1d3-b32f-4e46-9bfb-159a7f04ec1f" (reference "#PWR016") (unit 1))))) (text "Buffered analog output" (at 326 239 0) (effects (font (size 1.2 1.2)) (justify left)) (uuid "90c11038-91b1-4c0a-a9fb-ffc3c1c99c4a")) (text "PORTS" (at 15 255 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left)) (uuid "e98efd5c-1d95-477e-a2d3-3dd83e1018e3")) (text "ui_in[0] = HIGH    ui_in[1] = LOW    ui_in[2] = SHARE    ua[0] = VREFH    ua[1] = VOUT    ua[2] = VREFL" (at 15 261 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "5f964c32-5b70-47b1-9a9c-12b7d5ccf8ae")) (text "Initialize: HIGH=0, LOW=1, SHARE=1 for 8 us. Then 8 bits, LSB first: charge 2 us, dead 0.2 us, share 2 us, dead 0.2 us." (at 15 268 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "b6829f02-eefc-43f6-881f-de50ee15cd06")) (text "Bulk ties: every NMOS -> VGND; every PMOS -> VDPWR. Bulk pins are implicit in this drawing and explicit in the silicon netlist." (at 15 275 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "1266937a-b646-4e28-9ccc-24c22a06e0d2")) (text "Unused digital outputs are tied to VGND; ua[3:7] are isolated. Supply bypassing is provided by the Tiny Tapeout chip / board." (at 15 282 0) (effects (font (size 1.15 1.15)) (justify left)) (uuid "913407aa-ba20-4ef4-a172-ab519668386f")) (sheet_instances (path "/" (page "1"))))
